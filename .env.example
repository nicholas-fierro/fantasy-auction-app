# Copy to .env and fill in. Never commit the real .env (already gitignored).

# PocketBase URL as seen by the browser. Must be https:// in production (src/lib/env.ts enforces this).
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase URL as seen by server actions/route handlers. Usually the same as above; must be https:// in production.
POCKETBASE_URL=http://127.0.0.1:8090

# FantasyPros API key for /api/fantasypros/compare. Optional locally — that route
# degrades gracefully when unset (isFantasyProsConfigured() in src/server/lib/fantasypros.ts).
FANTASYPROS_API_KEY=
